---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectIndex from '../../components/ProjectIndex.astro';
import { personalProjectGroups } from '../../lib/content';
const groups = await personalProjectGroups();
---

<BaseLayout title="Personal Projects" description="Independent software projects and experiments.">
  <div class="wrap editorial-page">
    <header class="editorial-intro">
      <h1>Personal Projects</h1>
      <p>Software and experiments I work on outside of bioinformatics.</p>
    </header>
    {groups.map(({ title, items }, index) => (
      <section class="editorial-section" aria-labelledby={`personal-group-${index}`}>
        <h2 id={`personal-group-${index}`}>{title}</h2>
        <ProjectIndex items={items} showDemo={title === 'Selected projects'} />
      </section>
    ))}
  </div>
</BaseLayout>
