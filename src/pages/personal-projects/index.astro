---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../lib/content';
const items = await projects({ category: 'personal' });
---

<BaseLayout
  title="Personal Projects"
  description="Independent software projects, prototypes, and lessons from building practical tools."
>
  <div class="wrap index-page">
    <header class="page-intro">
      <span class="eyebrow">Independent projects</span>
      <h1>Personal Projects</h1>
      <p>Practical tools for everyday problems, and experiments in building useful software.</p>
      <p>
        Each project shows its current stage, the work behind it, and what remains to be tested.
      </p>
    </header>
    <section aria-labelledby="personal-projects-title">
      <div class="section-heading">
        <h2 id="personal-projects-title">Selected tools &amp; experiments</h2>
      </div>
      <div class="project-grid">
        {items.map((project) => (
          <ProjectCard project={project} variant="tile" />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
