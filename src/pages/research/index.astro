---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectIndex from '../../components/ProjectIndex.astro';
import PublicationList from '../../components/PublicationList.astro';
import { projects, publications, profile } from '../../lib/content';
import Icon from '../../components/Icon.astro';
const items = await projects({ category: 'research' });
const outputs = await publications();
const challengeIds = ['virtual-cell-challenge', 'genedis'];
const challenges = challengeIds
  .map((id) => items.find((project) => project.id === id))
  .filter((project) => project !== undefined);
const selected = (await projects({ category: 'research', featured: true }))
  .filter((project) => !challengeIds.includes(project.id));
const ongoing = items.filter((project) => !project.data.featured && !challengeIds.includes(project.id));
const p = await profile();
---

<BaseLayout
  title="Research"
  description="Academic and professional work in biological representations, omics analysis, and research software."
>
  <div class="wrap editorial-page">
    <header class="editorial-intro">
      <h1>Research</h1>
      <p>
        My work spans metagenomic gene neighborhoods, sequence and structural analysis,
        translational omics, and spatial imaging.
      </p>
    </header>
    <section class="editorial-section" aria-labelledby="research-projects-title">
      <h2 id="research-projects-title">Research projects</h2>
      <ProjectIndex items={selected} />
    </section>
    {ongoing.length > 0 && (
      <section class="editorial-section" aria-labelledby="ongoing-research-title">
        <h2 id="ongoing-research-title">Research in progress</h2>
        <ProjectIndex items={ongoing} />
      </section>
    )}
    {challenges.length > 0 && (
      <section class="editorial-section" aria-labelledby="research-challenges-title">
        <h2 id="research-challenges-title">Research challenges</h2>
        <ProjectIndex items={challenges} />
      </section>
    )}
    <section class="editorial-section" aria-labelledby="interests-title">
      <h2 id="interests-title">Research interests</h2>
      <div class="interest-grid">
        {p.data.interests.map((interest) => (
          <div>
            <h3>{interest.title}</h3>
            <p>{interest.description}</p>
          </div>
        ))}
      </div>
      {p.data.exploring && <p class="exploring">{p.data.exploring}</p>}
    </section>
    <section class="editorial-section" aria-labelledby="research-outputs-title">
      <div class="editorial-section-heading">
        <h2 id="research-outputs-title">Research outputs</h2>
        <a class="text-link" href="/cv/">
          View CV <Icon />
        </a>
      </div>
      <PublicationList items={outputs} />
    </section>
  </div>
</BaseLayout>
