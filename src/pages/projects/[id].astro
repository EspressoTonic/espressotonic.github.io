---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import HorseRacingEvidence from '../../components/HorseRacingEvidence.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectMedia from '../../components/ProjectMedia.astro';
import PublicationList from '../../components/PublicationList.astro';
import Icon from '../../components/Icon.astro';
import { projects, label, publications, reviewDate } from '../../lib/content';
export async function getStaticPaths() {
  return (await projects()).map((project) => ({ params: { id: project.id }, props: { project } }));
}
interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const d = project.data;
const { Content, headings } = await render(project);
const back = d.category === 'research' ? '/research/' : '/personal-projects/';
const categoryLabel = d.category === 'research' ? 'Research' : 'Personal Projects';
const outputs = (await publications()).filter((p) => d.publicationIds.includes(p.id));
const researchDiagram = ['magraph', 'enzymematch'].includes(project.id);
const hasScreenshot = d.category === 'personal' && !!d.cover;
const sections = headings.filter((heading) => heading.depth === 2);
---

<BaseLayout title={d.title} description={d.summary} category={d.category}>
  <article class:list={['wrap', 'detail-page', { 'personal-detail': hasScreenshot }]}>
    <a class="text-link back-link" href={back}>
      <Icon name="back" />
      Back to {categoryLabel}
    </a>
    {researchDiagram ? (
      <header class="research-intro">
        <h1>{d.title}</h1>
        <p class="project-summary">{d.summary}</p>
        <div class="research-facts-row">
          <dl class="project-facts research-facts">
            <div>
              <dt>Context:</dt>
              <dd>
                {categoryLabel} · {label(d.context)}
              </dd>
            </div>
            <div>
              <dt>Status:</dt>
              <dd>{label(d.status)}</dd>
            </div>
            {d.dateLabel && (
              <div>
                <dt>Period:</dt>
                <dd>{d.dateLabel}</dd>
              </div>
            )}
            <div>
              <dt>Role:</dt>
              <dd>{d.role}</dd>
            </div>
            {d.topics.length > 0 && (
              <div>
                <dt>Topics:</dt>
                <dd>{d.topics.join(' · ')}</dd>
              </div>
            )}
            <div>
              <dt>Reviewed:</dt>
              <dd>{reviewDate(d.updated)}</dd>
            </div>
          </dl>
          {d.links.length > 0 && (
            <div class="case-links">
              {d.links.map((link) => (
                <a class="button" href={link.url}>
                  {link.label}
                  <Icon name="external" />
                </a>
              ))}
            </div>
          )}
        </div>
      </header>
    ) : hasScreenshot ? (
      <header class="personal-intro">
        <div>
          <div class="case-tags">
            <span>
              {categoryLabel} · {label(d.context)}
            </span>
            <span>{label(d.status)}</span>
          </div>
          <h1>{d.title}</h1>
          <p class="project-summary">{d.summary}</p>
          <dl class="project-facts personal-facts">
            {d.dateLabel && (
              <div>
                <dt>Period</dt>
                <dd>{d.dateLabel}</dd>
              </div>
            )}
            <div>
              <dt>Role</dt>
              <dd>{d.role}</dd>
            </div>
            {d.topics.length > 0 && (
              <div>
                <dt>Topics</dt>
                <dd>{d.topics.join(' · ')}</dd>
              </div>
            )}
            <div>
              <dt>Review date</dt>
              <dd>{reviewDate(d.updated)}</dd>
            </div>
            {d.statusDetail && (
              <div class="fact-stage">
                <dt>Current stage</dt>
                <dd>{d.statusDetail}</dd>
              </div>
            )}
          </dl>
          {d.links.length > 0 && (
            <div class="case-links">
              {d.links.map((link) => (
                <a class="text-link" href={link.url}>
                  {link.label}
                  <Icon name="external" />
                </a>
              ))}
            </div>
          )}
        </div>
        <ProjectMedia project={project} context="detail" loading="eager" />
      </header>
    ) : (
      <header class="text-project-top">
        <div>
          <span class="eyebrow">{categoryLabel} / Case study</span>
          <h1>{d.title}</h1>
          <p class="project-summary">{d.summary}</p>
          {d.links.length > 0 && (
            <div class="case-links">
              {d.links.map((link) => (
                <a class="text-link" href={link.url}>
                  {link.label}
                  <Icon name="external" />
                </a>
              ))}
            </div>
          )}
        </div>
        <dl class="project-facts text-facts">
          <div>
            <dt>Current stage</dt>
            <dd>{d.statusDetail ?? label(d.status)}</dd>
          </div>
          <div>
            <dt>My role</dt>
            <dd>{d.role}</dd>
          </div>
          {d.dateLabel && (
            <div>
              <dt>Period</dt>
              <dd>{d.dateLabel}</dd>
            </div>
          )}
        </dl>
      </header>
    )}
    {d.draft && <p class="draft-notice">Draft preview · Public wording awaits review.</p>}
    {!hasScreenshot && (researchDiagram || d.cover) && (
      <div class="research-cover">
        <ProjectMedia project={project} context="detail" loading="eager" />
      </div>
    )}
    <div class="project-body">
      {sections.length > 0 && (
        <nav class="toc" aria-label="On this page">
          <span class="eyebrow">On this page</span>
          <div class="toc-links">
            {sections.map((heading) => (
              <a href={`#${heading.slug}`}>{heading.text}</a>
            ))}
          </div>
        </nav>
      )}
      <div class="prose">
        {project.id === 'horse-racing' && <HorseRacingEvidence />}
        <Content />
        {d.figures.length > 0 && (
          <section>
            <h2>Images and diagrams</h2>
            {d.figures.map((figure) => (
              <figure id={figure.id}>
                <Image src={figure.src} alt={figure.alt} width={880} loading="lazy" />
                <figcaption>
                  {figure.caption}
                  {figure.attribution && <> · {figure.attribution}</>}
                </figcaption>
              </figure>
            ))}
          </section>
        )}
        {outputs.length > 0 && (
          <section>
            <h2>Related research outputs</h2>
            <PublicationList items={outputs} />
          </section>
        )}
      </div>
    </div>
    <div class="category-return">
      <a class="text-link" href={back}>
        Explore all {categoryLabel.toLowerCase()} <Icon />
      </a>
    </div>
  </article>
</BaseLayout>
