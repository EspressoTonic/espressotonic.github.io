---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectIndex from '../components/ProjectIndex.astro';
import PublicationList from '../components/PublicationList.astro';
import SocialProfiles from '../components/SocialProfiles.astro';
import portrait from '../assets/identity/portrait.jpg';
import {
  profile,
  homepageProjects,
  publications,
  posts,
  postUrl,
  reviewDate,
} from '../lib/content';

const p = await profile();
const { Content } = await render(p);
const { hero, research, personal } = await homepageProjects();
const selectedResearch = hero ? [hero, ...research] : research;
const outputs = (await publications()).sort((a, b) => b.data.year - a.data.year);
const blog = await posts();
---

<BaseLayout>
  <div class="wrap editorial-page home-editorial">
    <header class="editorial-intro home-intro">
      <div class="home-intro-text">
        <h1>{p.data.name}</h1>
        <p class="intro-role">Bioinformatics researcher</p>
        <div class="intro-copy">
          <Content />
        </div>
        <nav class="editorial-links" aria-label="Quick links">
          <a href="#publications-title">Publications</a>
          <a href="/cv/">View CV</a>
          {p.data.email && <a href={`mailto:${p.data.email}`}>Email</a>}
        </nav>
      </div>
      <img
        class="home-portrait"
        src={portrait.src}
        alt={p.data.name}
        width={portrait.width}
        height={portrait.height}
      />
    </header>

    <section class="editorial-section" aria-labelledby="publications-title">
      <h2 id="publications-title">Selected publications</h2>
      <PublicationList items={outputs} variant="compact" />
    </section>

    {selectedResearch.length > 0 && (
      <section class="editorial-section" aria-labelledby="research-title">
        <div class="editorial-section-heading">
          <h2 id="research-title">Selected research</h2>
          <a href="/research/">All research</a>
        </div>
        <ProjectIndex items={selectedResearch} featureId={hero?.id} />
      </section>
    )}

    {personal.length > 0 && (
      <section class="editorial-section personal-home" aria-labelledby="personal-title">
        <div class="editorial-section-heading">
          <h2 id="personal-title">Selected software &amp; experiments</h2>
          <a href="/personal-projects/">All personal projects</a>
        </div>
        <ProjectIndex items={personal} />
      </section>
    )}

    <section class="editorial-section" aria-labelledby="interests-title">
      <h2 id="interests-title">Research interests</h2>
      <ul class="editorial-interests">
        {p.data.interests.map((interest) => (
          <li>{interest.title}</li>
        ))}
      </ul>
      {p.data.exploring && <p>{p.data.exploring}</p>}
    </section>

    {blog.length > 0 && (
      <section class="editorial-section" id="blog" aria-labelledby="blog-title">
        <div class="editorial-section-heading">
          <h2 id="blog-title">Writing</h2>
          <a href="/blog/">All posts</a>
        </div>
        <ol class="blog-post-list">
          {blog.slice(0, 3).map((post) => (
            <li>
              {post.data.publishedDate && (
                <time datetime={post.data.publishedDate}>
                  {reviewDate(post.data.publishedDate)}
                </time>
              )}
              <h3>
                <a href={postUrl(post.id)} lang={post.data.language}>
                  {post.data.title}
                </a>
              </h3>
              <p lang={post.data.language}>{post.data.excerpt}</p>
            </li>
          ))}
        </ol>
      </section>
    )}

    <section
      class="editorial-section editorial-contact"
      id="contact"
      aria-labelledby="contact-title"
    >
      <h2 id="contact-title">Contact</h2>
      <nav class="editorial-links" aria-label="Professional links">
        {p.data.email && <a href={`mailto:${p.data.email}`}>Email</a>}
        {p.data.links.map((link) => (
          <a href={link.url}>{link.label}</a>
        ))}
        <a href="/blog/">Blog</a>
      </nav>
      {p.data.socialProfiles.length > 0 && (
        <div id="sns" class="social-group">
          <h3 id="social-title">Elsewhere</h3>
          <SocialProfiles items={p.data.socialProfiles} />
        </div>
      )}
    </section>
  </div>
</BaseLayout>
