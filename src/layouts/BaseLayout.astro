---
import { profile } from '../lib/content';
import SocialProfiles from '../components/SocialProfiles.astro';
import '../styles/global.css';
import '../styles/editorial.css';
import '../styles/print.css';
interface Props {
  title?: string;
  description?: string;
  category?: 'research' | 'personal';
  language?: 'en' | 'ko';
  showSocial?: boolean;
  article?: { publishedDate?: string; updated?: string };
}
const p = await profile();
const {
  title,
  description = p.data.headline,
  category,
  language = 'en',
  showSocial = true,
  article,
} = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const active = (href: string) =>
  path.startsWith(href) ||
  (href === '/research/' && path.startsWith('/projects/') && category === 'research') ||
  (href === '/personal-projects/' && path.startsWith('/projects/') && category === 'personal');
const pageTitle = title ? `${title} — ${p.data.name}` : `${p.data.name} — Computational Biology`;
const nav = [
  { label: 'Research', href: '/research/' },
  { label: 'Personal Projects', href: '/personal-projects/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'CV', href: '/cv/' },
];
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/inter-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/sora-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <meta name="theme-color" content="#0d0d0d" />
    <script is:inline>
      {
        const key = 'portfolio-theme';
        const root = document.documentElement;
        const themeColor = document.querySelector('meta[name="theme-color"]');
        const apply = (theme) => {
          root.dataset.theme = theme;
          themeColor?.setAttribute('content', theme === 'light' ? '#faf9f7' : '#0d0d0d');
        };
        try {
          if (localStorage.getItem(key) === 'light') apply('light');
        } catch {
          // Default to dark if storage is unavailable.
        }
        document.addEventListener(
          'DOMContentLoaded',
          () => {
            const button = document.querySelector('[data-theme-toggle]');
            if (!button) return;
            const update = () => {
              const next = root.dataset.theme === 'light' ? 'dark' : 'light';
              const label = `Switch to ${next} mode`;
              button.textContent = next === 'light' ? 'Light' : 'Dark';
              button.setAttribute('aria-label', label);
              button.title = label;
            };
            update();
            button.hidden = false;
            button.addEventListener('click', () => {
              const next = root.dataset.theme === 'light' ? 'dark' : 'light';
              apply(next);
              update();
              try {
                localStorage.setItem(key, next);
              } catch {
                // The current page still switches if the choice cannot be saved.
              }
            });
          },
          { once: true },
        );
      }
    </script>
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/social-preview.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    {article?.publishedDate && (
      <meta property="article:published_time" content={article.publishedDate} />
    )}
    {article?.updated && <meta property="article:modified_time" content={article.updated} />}
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header" lang="en">
      <div class="wrap header-inner">
        <a class="wordmark" href="/">
          {p.data.name}
        </a>
        <nav aria-label="Main navigation">
          {nav.map((item) => (
            <a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
        <button class="theme-toggle" type="button" data-theme-toggle hidden>
          Light
        </button>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer" lang="en">
      <div class="wrap">
        <div class="footer-main">
          <div>
            <a class="wordmark" href="/">
              {p.data.name}
            </a>
            <p>Computational biology &amp; scientific software</p>
          </div>
          <nav aria-label="Contact">
            {p.data.email && <a href={`mailto:${p.data.email}`}>Email</a>}
            {p.data.links.map((link) => (
              <a href={link.url}>{link.label}</a>
            ))}
            <a href="/blog/">Blog</a>
            <a href="/cv/">CV</a>
          </nav>
        </div>
        {showSocial && p.data.socialProfiles.length > 0 && (
          <div class="footer-social social-group">
            <span class="eyebrow">SNS</span>
            <SocialProfiles items={p.data.socialProfiles} />
          </div>
        )}
      </div>
    </footer>
  </body>
</html>
