---
import SocialBrandIcon from './SocialBrandIcon.astro';
interface Props {
  items: { label: string; url?: string }[];
}
const { items } = Astro.props;
---

<ul class="social-labels" aria-label="Social platforms">
  {items.map((item) => (
    <li>
      {item.url ? (
        <a class="social-profile" href={item.url}>
          <SocialBrandIcon label={item.label} />
          {item.label}
        </a>
      ) : (
        <span class="social-profile">
          <SocialBrandIcon label={item.label} />
          {item.label}
        </span>
      )}
    </li>
  ))}
</ul>
