---
import ProjectMedia from './ProjectMedia.astro';
import Icon from './Icon.astro';
import { projectUrl, label } from '../lib/content';
import type { CollectionEntry } from 'astro:content';
interface Props {
  project: CollectionEntry<'projects'>;
  headingLevel?: 2 | 3;
  compact?: boolean;
  variant?: 'row' | 'feature' | 'visual' | 'home-research';
}
const { project, headingLevel = 3, variant = 'row', compact = false } = Astro.props;
const d = project.data;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const showMedia =
  variant !== 'row' &&
  (!!d.cover ||
    ['magraph', 'enzymematch', 'virtual-cell-challenge', 'genomycanalyzer'].includes(project.id));
const summary = compact || variant === 'home-research' ? (d.shortSummary ?? d.summary) : d.summary;
const titleParts =
  project.id === 'genomycanalyzer' && variant === 'home-research'
    ? d.title.split(' (published as ')
    : undefined;
---

<article
  class:list={['project-card', `project-${variant}`, d.category, { 'has-media': showMedia }]}
  data-project-id={project.id}
>
  {variant === 'visual' && showMedia && (
    <div class="card-media">
      <ProjectMedia project={project} />
    </div>
  )}
  <div class="project-card-copy">
    <span class="project-meta">
      {d.statusDetail ?? `${label(d.context)} · ${label(d.status)}`}
      {d.draft && <span class="draft-label">Draft preview</span>}
    </span>
    <Heading>
      <a href={projectUrl(project.id)}>
        {titleParts ? (
          <>
            {titleParts[0]}
            <span class="project-alias">Published as {titleParts[1]?.replace(/\)$/, '')}</span>
          </>
        ) : (
          d.title
        )}
      </a>
    </Heading>
    {variant === 'row' && <p class="card-role">{d.role}</p>}
    <p>{summary}</p>
    {variant === 'feature' && showMedia && <ProjectMedia project={project} />}
    <a class="text-link" href={projectUrl(project.id)}>
      Read project <Icon />
    </a>
  </div>
  {variant === 'home-research' && showMedia && (
    <div class="card-media">
      <div class="diagram-header">
        <span>
          {project.id === 'virtual-cell-challenge'
            ? 'Model comparison and evaluation'
            : 'Reproducible software workflow'}
        </span>
        <span>Concept illustration</span>
      </div>
      <ProjectMedia project={project} />
    </div>
  )}
</article>
